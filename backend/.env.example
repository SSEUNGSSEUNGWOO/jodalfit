# 공공데이터포털 - 조달청 나라장터 OpenAPI
NARAJANGTEO_API_KEY=

# OpenAI - 임베딩
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# CORS (콤마 구분 X, JSON 배열 형식)
# CORS_ORIGINS=["http://localhost:3000","https://jodalfit.co.kr"]

# 봇/스크래퍼 차단 — 미설정 시 가드 비활성(개발 편의).
# 토큰 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 프론트엔드(.env.local 또는 Vercel)의 INTERNAL_API_TOKEN과 같은 값으로 설정.
# INTERNAL_API_TOKEN=
# ALLOWED_REFERER_HOSTS=["jodalfit.co.kr","www.jodalfit.co.kr"]
